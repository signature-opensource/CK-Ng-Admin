<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>Generic per-user WebSocket channel: the server pushes typed messages to every connection of a given user. The socket itself is anonymous and returns a connection identifier; the identity is bound afterwards by an authenticated Cris command carrying that identifier, so no token ever transits through the socket URL.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CK.Cris.AspNet" Version="0.55.3--ci.1" />
        <PackageReference Include="CK.Cris.Auth" Version="0.43.2--ci.1" />
        <PackageReference Include="CK.Cris.Typescript" Version="0.55.3--ci.1" />
        <PackageReference Include="CK.TypeScript" Version="0.31.3--ci.7" />
        <PackageReference Include="SimpleR.Server" Version="1.0.0" />
    </ItemGroup>

</Project>
