<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>Binds the connections of the application-wide WebSocket channel to their user, so that a feature can push a typed message to every connection of a given user. The socket is anonymous and returns a connection identifier; the identity is bound afterwards by an authenticated Cris command carrying that identifier, so no token ever transits through the socket URL.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CK.Cris.AspNet" Version="0.55.3--ci.1" />
        <PackageReference Include="CK.Cris.Auth" Version="0.43.2--ci.1" />
        <PackageReference Include="CK.Cris.Typescript" Version="0.55.3--ci.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- TEMPORARY: replace with a PackageReference to CK.AspNet.WebSocketChannel once CK-TypeScript
             has been released on the CI feed. -->
        <ProjectReference Include="..\..\CK-TypeScript\CK.AspNet.WebSocketChannel\CK.AspNet.WebSocketChannel.csproj" />
    </ItemGroup>

</Project>
