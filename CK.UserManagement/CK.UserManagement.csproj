<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Data access for the command handlers. -->
        <PackageReference Include="CK.SqlServer.Dapper" Version="15.0.1" />
        <PackageReference Include="CK.SqlServer.Transaction" Version="12.0.1" />

        <!-- Standard CK.DB building blocks used by the handlers. -->
        <PackageReference Include="CK.DB.Workspace" Version="15.1.1--ci.8" />
        <PackageReference Include="CK.DB.Zone" Version="28.0.2--ci.3" />
        <PackageReference Include="CK.DB.User.NamedUser" Version="28.0.2--ci.2" />
        <PackageReference Include="CK.DB.User.UserPassword" Version="28.0.2--ci.2" />
        <PackageReference Include="CK.DB.User.PreferredCulture" Version="0.4.2--ci.2" />
        <PackageReference Include="CK.DB.Actor.ActorEMail" Version="28.0.2--ci.2" />
        <PackageReference Include="CK.DB.TokenStore" Version="0.38.2--ci.2" />
        <PackageReference Include="CK.DB.Globalization" Version="0.1.4--ci.6" />


        <!-- Invitation e-mail: Fluid templates rendered + sent via the CK-AppIdentity-configured mailer.
             Res/Templates/*.liquid are auto-embedded by CK.EmbeddedResources (buildTransitive). -->
        <PackageReference Include="CK.Mailer.MailKit" Version="12.0.1" />
        <PackageReference Include="CK.Template.Fluid" Version="0.0.0" />
        <PackageReference Include="CK.AppIdentity.Abstractions" Version="0.14.1" />
    </ItemGroup>


    <ItemGroup>
        <EmbeddedResource Include="**\*.sql" />
        <EmbeddedResource Include="**\*.tql" />
    </ItemGroup>


    <ItemGroup>
        <ProjectReference Include="..\CK.IO.UserManagement\CK.IO.UserManagement.csproj" />
        <ProjectReference Include="..\CK.Mail.SharedLayout\CK.Mail.SharedLayout.csproj" />
    </ItemGroup>

</Project>
