{
  // The configuration of the App: its BinPath "CK.Ng.Admin.Sample" is the CK.Ng.Admin.Sample.App project (its code) and the
  // CK.Ng.Admin.Sample.Host project, whose appsettings.json is generated from the "CK.Ng.Admin.Sample" section below (without its compile
  // time keys).
  "App": {
    "BinPaths": {
      "CK.Ng.Admin.Sample": {
        "Globalization": { "ActiveCultures": "fr" },
        "AllowedHosts": "*",
        "Authentication": {
            "Oidc.SignatureAD": {
                "Instance": "https://login.microsoftonline.com/",
                "ClientId": "",
                "TenantId": "",
                "ClientSecret": "",
                "CallbackPath": "/signin-oidc-signature",
                "SignedOutCallbackPath ": "/signout-callback-oidc-signature",
                "RequireHttpsMetadata": false
            }
        },
        "CK-AppIdentity": {
            "FullName": "AdminSample/$Server",
            "Parties": [],
            "Local": {
                // This application is its own AuthCenter, and its web server is its "HttpEndpoint" feature.
                "AllowFeatures": "AuthCenter, HttpEndpoint",
                "HttpEndpoint": {
                    "Main": {
                        "Urls": "http://localhost:5500"
                    }
                },
                "AuthCenter": {
                    "CriticalLifetimes": {
                        "Basic": "00:05:00"
                    }
                },
                "PasswordLostTokenLifetime": "02:00:00",
                "EmailSender": {
                    "Smtp": {
                        "SendEmail": false,
                        "UsePickupDirectory": true,
                        "PickupDirectory": "MailPickup",
                        "From": "noreply@adminsample.local"
                    }
                },
                "PartyClient": { "App": { "Type": "TypeScript", "Kind": "DefaultApp", "DevServerPort": 4500, "IntegrationMode": "Inline", "DefaultCulture": "fr", "ActiveCultures": "fr-CA, de-be, nl-BE, zh" } }
            }
        },
        "CK-Monitoring": {
            "LogPath": "Logs",
            "HandleDotNetLogs": true,
            "DefaultFilter": "Debug",
            "GrandOutput": {
                "Handlers": {
                    "Console": true,
                    "TextFile": {
                        "Path": "Text"
                    }
                }
            }
        },
        "Logging": {
            "LogLevel": {
                "Default": "Information",
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Warning"
            },
            "Console": {
                "LogLevel": {
                    "Default": "None"
                },
                "FormatterOptions": {
                    "IncludeScopes": false
                }
            },
            "Debug": {
                "LogLevel": {
                    "Default": "None"
                }
            }
        }
      }
    }
  }
}
